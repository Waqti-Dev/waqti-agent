<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is blocked by default (Android 9+). The model endpoint may be a
  local loopback server (e.g. 127.0.0.1:8080 or an emulator host alias), so
  cleartext is permitted for loopback addresses only. Everything else stays
  TLS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
